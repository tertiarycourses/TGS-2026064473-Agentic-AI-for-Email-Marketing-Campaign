      "parameters": {
        "jsCode": "const b=$json.brief||{}; const required=['campaign_id','brief_version','objective','eligible_group','exclusions','primary_cta','cta_url','voice','prohibited_claims','source_ids','schedule_local','timezone']; const errors=required.filter(k=>b[k]===undefined||b[k]===null||b[k]===''||(Array.isArray(b[k])&&b[k].length===0)).map(k=>`missing_${k}`); if((b.exclusions||[]).length<2) errors.push('at_least_two_exclusions'); const canonical=JSON.stringify(b,Object.keys(b).sort()); return [{json:{...b,validation_ok:errors.length===0,validation_errors:errors,brief_hash:require('crypto').createHash('sha256').update(canonical).digest('hex')}}];"
