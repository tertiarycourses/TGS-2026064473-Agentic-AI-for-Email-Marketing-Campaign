    {
      "parameters": {
        "jsCode": "const status=Number($json.statusCode); const campaign=$json.body?.data;\nif(status!==200||!campaign?.id) throw new Error(`MailerLite schedule failed: HTTP ${status}; ${JSON.stringify($json.body?.errors||$json.body?.message||'missing campaign id')}`);\nconst release=$('Validate Draft Response').item.json;\nreturn [{json:{result:'scheduled',campaign_id:campaign.id,campaign_status:campaign.status,scheduled_for:campaign.scheduled_for||null,approved_payload_hash:release.approved_payload_hash,review_decision:release.review_decision,execution_id:$execution.id,evidence_at:new Date().toISOString()}}];"
