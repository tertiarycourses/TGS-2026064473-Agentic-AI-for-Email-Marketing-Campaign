        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{JSON.stringify({delivery:'scheduled',schedule:$json.schedule})}}",
        "options": {
