            }
          ]
        },
        "options": {}
      },
      "id": "a09aaefe-6a29-5a4a-9698-d3f1ac9d53d8",
      "name": "Load Pending Newsletter",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -1190,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "const crypto=require('crypto');\nconst stable=v=>Array.isArray(v)?`[${v.map(stable).join(',')}]`:(v&&typeof v==='object'?`{${Object.keys(v).sort().map(k=>`${JSON.stringify(k)}:${stable(v[k])}`).join(',')}}`:JSON.stringify(v));\nconst payload=$json.payload;\nconst canonical=stable(payload);\nconst approved_payload_hash=crypto.createHash('sha256').update(canonical).digest('hex');\nreturn [{json:{payload,canonical,approved_payload_hash,review_expires_at:new Date(Date.now()+86400000).toISOString()}}];"
      },
      "id": "23b8997f-4167-5027-9692-de3351f6d7df",
      "name": "Canonicalize and Hash",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -950,
        180
      ]
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "sendTo": "reviewer@example.com",
        "subject": "=Newsletter approval needed: {{ $('Canonicalize and Hash').item.json.payload.subject }}",
        "message": "=Campaign: {{ $('Canonicalize and Hash').item.json.payload.campaign_id }} v{{ $('Canonicalize and Hash').item.json.payload.content_version }}\nSubject: {{ $('Canonicalize and Hash').item.json.payload.subject }}\nAudience group: {{ $('Canonicalize and Hash').item.json.payload.group_id }}\nCTA: {{ $('Canonicalize and Hash').item.json.payload.cta_url }}\nSchedule: {{ JSON.stringify($('Canonicalize and Hash').item.json.payload.schedule) }}\nPayload SHA-256: {{ $('Canonicalize and Hash').item.json.approved_payload_hash }}\nExpires: {{ $('Canonicalize and Hash').item.json.review_expires_at }}\n\nApprove only if this exact payload may be created and scheduled in MailerLite.",
        "approvalOptions": {
          "values": {
            "approvalType": "double"
          }
        },
        "options": {}
      },
      "id": "61ae22e0-452e-5fc8-bbf6-413ce5859a16",
