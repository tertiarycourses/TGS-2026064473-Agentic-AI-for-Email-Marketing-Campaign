      "parameters": {
        "description": "Create and schedule a MailerLite campaign only after human approval. Input is JSON with subject, html, from_name, verified_sender, group_id, schedule, timezone_id and payload_hash.",
        "jsCode": "const p=JSON.parse(query); const required=['subject','html','from_name','verified_sender','group_id','schedule','timezone_id','payload_hash']; const missing=required.filter(k=>!p[k]); if(missing.length) throw new Error('missing:'+missing.join(',')); return JSON.stringify({status:'APPROVED_FOR_MAILERLITE_HTTP_REQUESTS',payload:p});"
      },
      "id": "68b5c515-f506-59d4-847a-c5902d480f06",
