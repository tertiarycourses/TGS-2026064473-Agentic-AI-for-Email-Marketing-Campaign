    {
      "parameters": {
        "method": "POST",
        "url": "https://connect.mailerlite.com/api/campaigns",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{JSON.stringify($json.request)}}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "id": "9b2f5c3e-2497-545a-bfa6-6da8f1519c5a",
      "name": "Create MailerLite Campaign",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        620,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const status=Number($json.statusCode); const campaign=$json.body?.data;\nif(status!==200||!campaign?.id) throw new Error(`MailerLite draft failed: HTTP ${status}; ${JSON.stringify($json.body?.errors||$json.body?.message||'missing campaign id')}`);\nconst release=$('Prepare MailerLite Campaign').item.json;\nreturn [{json:{campaign_id:campaign.id,draft_status:campaign.status,schedule:release.schedule,approved_payload_hash:release.approved_payload_hash,review_decision:release.review_decision}}];"
      },
      "id": "bac0973b-20a2-5c8f-82e5-5439a0730326",
      "name": "Validate Draft Response",
