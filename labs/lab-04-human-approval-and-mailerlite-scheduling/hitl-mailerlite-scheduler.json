    {
      "parameters": {
        "jsCode": "const crypto=require('crypto');\nconst stable=v=>Array.isArray(v)?`[${v.map(stable).join(',')}]`:(v&&typeof v==='object'?`{${Object.keys(v).sort().map(k=>`${JSON.stringify(k)}:${stable(v[k])}`).join(',')}}`:JSON.stringify(v));\nconst source=$('Canonicalize and Hash').item.json;\nconst current_payload=source.payload;\nconst current_hash=crypto.createHash('sha256').update(stable(current_payload)).digest('hex');\nconst approval_not_expired=Date.now()<Date.parse(source.review_expires_at);\nreturn [{json:{payload:current_payload,approved_payload_hash:source.approved_payload_hash,current_payload_hash:current_hash,hash_matches:current_hash===source.approved_payload_hash,approval_not_expired,review_decision:$json.data,review_expires_at:source.review_expires_at}}];"
      },
