        "jsCode": "const body=$json.body?.data||$json.body||{}; return [{json:{subscriber_id:body.id||null,email:body.email||$('Normalize Lead').item.json.email,status:body.status||null,http_status:$json.statusCode,execution_id:$execution.id,evidence_at:new Date().toISOString()}}];"
      },
