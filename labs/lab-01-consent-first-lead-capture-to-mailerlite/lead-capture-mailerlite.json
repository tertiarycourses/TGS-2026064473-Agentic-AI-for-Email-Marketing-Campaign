    {
      "parameters": {
        "jsCode": "const email = String($json.Email || '').trim().toLowerCase();\nconst consent = Boolean($json['I agree to receive marketing emails']);\nconst valid = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\nreturn [{json:{...$json,email,name:String($json.Name||'').trim(),company:String($json.Company||'').trim(),consent,opted_in_at:new Date().toISOString().replace('T',' ').replace('Z',''),validation_ok:valid&&consent,validation_error:!valid?'invalid_email':(!consent?'consent_required':'')}}];"
      },
      "id": "ade8da84-3525-5850-b104-4a6bf9f814cb",
      "name": "Normalize Lead",
