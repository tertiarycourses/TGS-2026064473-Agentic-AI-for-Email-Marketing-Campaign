        "responseMode": "responseNode",
        "options": {}
      },
      "id": "dcb75e1c-1c6e-5909-a8e7-77e38313f6ce",
      "name": "Dashboard Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -740,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const events=[{type:'sent',n:10000},{type:'delivered',n:9700},{type:'opened',n:3100},{type:'clicked',n:520},{type:'converted',n:82},{type:'unsubscribed',n:24},{type:'bounced',n:300}]; return [{json:{events,campaign:'AEMC-2026-001',cohort:'all'}}];"
      },
      "id": "b36729d4-2f02-560f-9ff1-60a0fb1e09b6",
      "name": "Load Campaign Events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -500,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const m=Object.fromEntries($json.events.map(e=>[e.type,e.n])); const rate=(a,b)=>b?+(100*a/b).toFixed(2):null; return [{json:{...$json,metrics:{delivery_rate:rate(m.delivered,m.sent),open_rate:rate(m.opened,m.delivered),ctr:rate(m.clicked,m.delivered),ctor:rate(m.clicked,m.opened),conversion_rate:rate(m.converted,m.clicked),unsubscribe_rate:rate(m.unsubscribed,m.delivered)},funnel:m}}];"
      },
      "id": "6652fcd6-4e5c-5cc2-89d5-0f22f8356368",
      "name": "Aggregate KPIs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -250,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const k=$json.metrics,f=$json.funnel; const bars=['sent','delivered','opened','clicked','converted'].map(x=>`<div class=bar><b>${x}</b><span style=width:${Math.max(2,100*f[x]/f.sent)}%></span><em>${f[x]}</em></div>`).join(''); const cards=Object.entries(k).map(([a,b])=>`<article><small>${a.replaceAll('_',' ')}</small><strong>${b===null?'N/A':b+'%'}</strong></article>`).join(''); return [{json:{html:`<!doctype html><meta charset=utf-8><title>Newsletter dashboard</title><style>body{font:16px Arial;margin:40px;color:#17202a;background:#f7faf9}h1{font-size:30px}section{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}article{background:white;padding:20px;border-radius:16px;border-left:6px solid #008f83}small{display:block;text-transform:uppercase;color:#667}strong{font-size:34px}.bar{display:grid;grid-template-columns:110px 1fr 80px;gap:12px;align-items:center;margin:14px 0}.bar span{height:24px;background:#008f83;border-radius:8px}.bar em{text-align:right}</style><h1>Campaign ${$json.campaign}</h1><p>Cohort: ${$json.cohort}. Denominators are defined in metric-dictionary.md.</p><section>${cards}</section><h2>Funnel</h2>${bars}`}}];"
      },
      "id": "f43b7a16-3c3e-587b-b095-6d1a9de7beb6",
      "name": "Render Dashboard HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
