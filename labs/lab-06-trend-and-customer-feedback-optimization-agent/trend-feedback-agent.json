{
  "name": "LAB06 - Trend and Customer Feedback Optimization Agent",
  "nodes": [
    {
      "parameters": {},
      "id": "39433395-e237-5662-aff0-9ab4207e1056",
      "name": "When clicking Execute workflow",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -850,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{json:{window:'2026-W01..W06',ctr:[5.1,5.3,5.4,4.6,3.8,3.2],baseline:4.8,feedback:[{id:'F01',text:'too many emails this week'},{id:'F02',text:'clear and useful guide'},{id:'F03',text:'please reduce the frequency'}]}}];"
      },
      "id": "1c6468e3-a72f-5bbc-be60-874b502e7220",
      "name": "Load Trend and Feedback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -620,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const clean=$json.feedback.map(x=>({source_id:x.id,text:x.text.replace(/[\\w.+-]+@[\\w.-]+\\.[A-Za-z]{2,}/g,'[email]').replace(/\\b[A-Z][a-z]+ [A-Z][a-z]+\\b/g,'[name]')})); return [{json:{...$json,feedback:clean}}];"
      },
      "id": "05e51312-0925-567e-9c9c-0bfec5819255",
      "name": "De-identify Feedback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -390,
        200
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Window: {{$json.window}}\nCTR: {{JSON.stringify($json.ctr)}}\nBaseline: {{$json.baseline}}\nFeedback: {{JSON.stringify($json.feedback)}}",
        "options": {
          "systemMessage": "Return one evidence-card JSON with finding, source_ids, sample_size, window, confidence, counter_evidence, and two reversible recommendations. Separate observation from inference."
        },
        "hasOutputParser": true
      },
      "id": "079df55b-5a88-5ce7-bb4c-c370f9c7f284",
      "name": "Trend and Feedback Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -140,
        200
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\"finding\": \"CTR has remained below baseline for three weeks while frequency complaints recur\", \"source_ids\": [\"F01\", \"F03\"], \"sample_size\": 3, \"window\": \"2026-W01..W06\", \"confidence\": \"medium\", \"counter_evidence\": \"small feedback sample\", \"recommendations\": [\"test lower cadence\", \"test preference centre reminder\"]}"
      },
      "id": "245361e5-c092-53e0-9334-c2a828015d6e",
      "name": "Evidence Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        -120,
        480
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4.1-mini",
          "cachedResultName": "gpt-4.1-mini"
        },
        "options": {
          "responseFormat": "json_object"
        }
      },
      "id": "1e4a3e39-153d-5225-9939-8d3f62a3bce5",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        -350,
        480
      ]
    },
    {
      "parameters": {
        "jsCode": "const e=$json.output||$json; const ok=Boolean(e.finding&&e.source_ids?.length&&e.sample_size&&e.window&&e.confidence&&e.counter_evidence); const options=[{name:'lower cadence test',impact:4,confidence:3,reversibility:4,effort:2},{name:'full redesign',impact:4,confidence:2,reversibility:2,effort:5}].map(x=>({...x,priority:+(x.impact*x.confidence*x.reversibility/x.effort).toFixed(1)})); return [{json:{evidence_valid:ok,evidence:e,options,experiment:{hypothesis:'Lower cadence increases CTR without increasing unsubscribe rate',primary_metric:'CTR',guardrails:['unsubscribe_rate','complaint_rate','bounce_rate'],allocation:'50/50',window:'2 weeks',stop_rule:'minimum 1000 delivered per arm'}}}];"
      },
      "id": "4bf8194e-e68c-520f-a5e0-6aa436cbc220",
      "name": "Validate Evidence and Rank",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        140,
        200
      ]
    },
