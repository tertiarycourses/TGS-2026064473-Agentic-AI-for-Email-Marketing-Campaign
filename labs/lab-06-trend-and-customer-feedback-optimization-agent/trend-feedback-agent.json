        "conditions": {
          "options": {
            "version": 2,
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "7b2bc594-b243-5302-bdc9-7594d5a116c2",
              "leftValue": "={{$json.evidence_valid}}",
              "rightValue": true,
